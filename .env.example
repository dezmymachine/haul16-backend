# Copy to .env for local development. Real values belong in Railway/Vercel variables, never in git.
HAUL16_ENV=dev
HAUL16_PORT=8000
HAUL16_CT=1
HAUL16_DRY_RUN=1
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Neon (production) or the local docker postgres. Neon needs ?sslmode=require
DATABASE_URL=postgresql://haul16:haul16@127.0.0.1:55433/haul16
TEST_DATABASE_URL=postgresql://haul16:haul16@127.0.0.1:55433/haul16_test

# LLM (OpenAI now; the adapter in engine/llm.py takes Anthropic later)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Collectors (each optional: a missing key skips that collector and records why)
FIRECRAWL_API_KEY=
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=
APIFY_SOCIAL_ACTOR=
SEARCH_PROVIDER=brave
SEARCH_API_KEY=
URLSCAN_API_KEY=
META_AD_LIBRARY_TOKEN=

# Sign-in (one owner account). Sign-in is ON whenever AUTH_OWNER_PASSWORD is set.
# Production requires both a password and a long random SESSION_SECRET, or the API refuses to start.
AUTH_OWNER_EMAIL=owner@haul16.local
AUTH_OWNER_NAME=
AUTH_OWNER_PASSWORD=change-me-locally
SESSION_SECRET=

# Development only: add the fictional "Nkwa Exchange" demo brand on start (off by default)
SEED_DEMO_BRAND=false

# Public address of the frontend: used to build links in alert emails and webhooks
PUBLIC_URL=http://127.0.0.1:5173
# Scan an active brand again every N hours (0 = off). Each brand can override this in Settings.
PATROL_HOURS=6

# Alerts outside the app. All optional; the in-app bell always works.
ALERT_MIN_SEVERITY=medium
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=

# Email (alerts, and sending notices when HAUL16_DRY_RUN=0). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
EMAIL_FROM=haul16@localhost
EMAIL_REPLY_TO=
